// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  output        = "../src/lib/server/db/generated"
  runtime       = "workerd"
  moduleFormat  = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ListingKind {
  JOB
}

model Category {
  id        Int           @id @default(autoincrement())
  kind      ListingKind
  name      String
  icon      String?
  sortOrder Int           @default(0)
  active    Boolean       @default(true)

  interests Interest[]

  @@unique([kind, name])
}

// ---------- Better Auth ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  profile        Profile?
  workerProfile  WorkerProfile?
  interests      Interest[]
  jobTypePrefs   JobTypePreference[]
  qualifications Qualification[]
}

/// 'n Aangemelde toestel. Die koekie bevat `token`.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 'n Manier om aan te meld: providerId = "credential" (wagwoord) of "google".
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?                // hash, nooit die wagwoord self nie
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Eenmalige tokens: e-posverifikasie, wagwoordherstel.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Koersbeperking: hoeveel versoeke 'n sleutel (IP + pad) onlangs gemaak het.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ---------- Profiel (algemeen) ----------

/// Dorpsplein se data oor 'n gebruiker. Word in /begin geskep.
model Profile {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline       String?   @db.VarChar(80)   // "Ervare messelaar en teëlwerker"
  bio            String?   @db.VarChar(1000)
  photoKey       String?                     // R2-sleutel; val terug op User.image
  phone          String?   @db.VarChar(20)   // net gedeel ná ACCEPTED
  available      Boolean   @default(true)    // af = geen nuwe-plasing-kennisgewings
  publicProfile  Boolean   @default(true)    // af = net aangemelde lede sien /mense/[id]
  isAdmin        Boolean   @default(false)
  blocked        Boolean   @default(false)
  popiaConsentAt DateTime?                   // null = /begin nog nie voltooi
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Kwalifikasies: "Elektrisiën – Trade Test", "Eerstehulp Vlak 1".
model Qualification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(120)
  issuer    String?  @db.VarChar(120)
  year      Int?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// "Stuur my kennisgewings oor hierdie kategorie." Die basis van passing.
model Interest {
  userId          String
  categoryId      Int
  yearsExperience Int?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category @relation(fields: [categoryId], references: [id])
  createdAt       DateTime @default(now())

  @@id([userId, categoryId])
  @@index([categoryId])
}

// ---------- Werk-spesifiek ----------

enum JobType {
  PERMANENT
  PART_TIME
  ODD_JOB
  SEASONAL
}

model WorkerProfile {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  driversLicence Boolean  @default(false)
  ownTransport   Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model JobTypePreference {
  userId  String
  jobType JobType
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, jobType])
  @@index([jobType])
}